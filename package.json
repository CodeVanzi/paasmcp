{
  "name": "paasmcp",
  "version": "1.0.0",
  "description": "Self-hosted PaaS for Linux servers and homelabs, run from a full web dashboard, by AI agents through MCP (with human approval), or from the CLI.",
  "license": "MIT",
  "author": "PaaSMCP Contributors",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "paas",
    "self-hosted",
    "homelab",
    "docker",
    "cloudflare-tunnel",
    "tailscale",
    "ai-agents",
    "micro-paas",
    "dashboard",
    "web-ui",
    "failover",
    "high-availability"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "paasmcp": "./dist/cli.js",
    "paasmcp-mcp": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "start:mcp": "node dist/mcp-server.js",
    "cli": "node dist/cli.js",
    "test": "node --test dist/test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
